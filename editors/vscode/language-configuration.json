{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^[^#]*:\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*(?:elif|else)\\b[^#]*:\\s*(?:#.*)?$"
  },
  "onEnterRules": [
    {
      "beforeText": "^[^#]*=\\s*if\\b[^#]*:\\s*(?:#.*)?$",
      "action": { "indent": "indent", "appendText": "    " }
    },
    {
      "beforeText": "^[^#]*:\\s*(?:#.*)?$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*(?:return|pass)\\b(?!.*[(\\[{]\\s*(?:#.*)?$).*$",
      "action": { "indent": "outdent" }
    }
  ]
}
