# Every highlight class and every operator and punctuation spelling the lexer
# has, for the editor highlight check (editors/README.md). It parses; it need
# not type-check. TODO, FIXME and XXX are marked inside a comment; TODOs is not.
# TODO😀 and TODOé are marked too: only an ASCII letter, digit or _
# continues a word.

reqs, resps = http_serve(8080, 'GET', "/count")

@LoadFrom(previous)
total: Mut(Int, Txn)

events = defer()
events << `seen(1)
log <<= [e for e in events if e.ok and not e.skip or True]

def bump(n: {Int where _ >= 0}, flag: Bool, hole: _) => Int:
    if n == 0 or n != 1:
        return n ** 2 // 3
    elif n <= 4 and n > 5 or n < 6:
        return n ^+ 1
    else:
        pass
    m = n * 2 - 1 + 3
    m += 1; m -= 1; m *= 2; m //= 2
    return (m & 1) | (m ^ 1)

def evens(xs):
    for x in xs:
        yield x

with begin():
    match store[key]?:
        case `some(v):
            total := v
        case `none:
            total := 0

opaque ^= False
pairs = [k -> v for k in keys] ++ [x for x in "a\tb\"c\d"]
escapes = ["\n\r\\\0", '\'']
totals = sum([max(xs), groupby(xs, \x -> x)])
inc = \x -> x + 1
held <: {_ where _ > 0} = 1
apply: Int => _ = inc
