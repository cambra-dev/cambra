# Minimal yield generator (isolated from explicit defer).
#
# `def` + `for` + `yield` lowers to a defer-fed stream that is channelized
# during channelization. Maxing over a list literal keeps it a terminating batch
# computation. The Lambda/Compose/Record wrappers around the `x * x` body are
# the synthesized channelization plumbing.
def squared(xs):
    for x in xs:
        yield x * x

max(squared([1, 2, 3, 4]))
