# Each diagnostic's range and each symbol's range end below falls after a
# character wider than one byte, so its UTF-8 and UTF-16 columns differ: é is
# 2 bytes and 1 UTF-16 unit, € 3 and 1, 😀 4 and 2.
greeting = "héllo 😀"
price = "€" $
def shout(s):
    s + "😀" + café
def tag(a,
        b):  # 😀€
    a + b + "😀"
