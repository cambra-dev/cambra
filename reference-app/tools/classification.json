{
  "note": [
    "Every line of both implementations is assigned exactly one purpose.",
    "File globs classify whole files; `ranges` overrides a file line-range at a",
    "time, and count_loc.py reports how many lines came from each mechanism.",
    "Glob order matters: the first match wins."
  ],
  "categories": {
    "domain": "Business logic: pricing, reservation, the saga's state advances",
    "serialization": "DTOs, request validation, response mapping, endpoint declaration",
    "connections": "Pools, clients, and connection lifetime",
    "schema": "Data model, constraints, hand-written migrations, seed data",
    "fault-tolerance": "Retries, backoff, timeouts, compensation, timers",
    "flow-control": "Batching, backpressure, offset and delivery management",
    "authorization": "Authentication, authorization, policy",
    "etl": "Data movement and the warehouse: outbox relay, landing, loading, marts",
    "observability": "Logging, metrics, tracing",
    "config-infra": "Configuration, compose, images, build and run tooling",
    "tests-unit": "Unit tests",
    "tests-integration": "Integration and end-to-end tests",
    "generated": "Produced by a tool: Alembic autogenerate and its scaffolding",
    "stubs": "Local stand-ins for external services; excluded from application totals"
