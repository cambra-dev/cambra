# Copy to .env to override the compose defaults.

# The cart-abandonment wait. Production is 86400 (24 hours); the local stack
# defaults to 20 seconds so the timer fires inside a test run.
ABANDON_AFTER_SECONDS=20

# Forgone revenue the flash sale may spend before prices revert to list.
PROMO_BUDGET=1000

# Set to an OTLP HTTP endpoint to export traces; unset means traces are dropped.
# OTLP_ENDPOINT=http://localhost:4318/v1/traces

LOG_LEVEL=INFO
