# A program that runs `std::time::timer`: each input line opens or extends a session that expires
# 30 minutes after the transaction that reads it, and each firing records the expiry it reports.

import std::time

run std::time::timer(Key=String) as expiries

expired: Mut(Map(String, time::Instant), Txn) := empty_map()

for line in stdin():
    with begin():
        renewed = expiries::cancel(line)
        expiries::register(line, time::now() + time::minutes(30))

for f in expiries::fired:
    with begin():
        expired[f.key] := f.at
