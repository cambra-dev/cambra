# Storefront V1 — budgeted flash sale: 50% off list price while the promotion
# budget lasts.  Identical to v0.cambra except the `is_promo_spent` view and
# `quote`; the diff between the two files IS the upgrade.
#
# This is the version-upgrade dimension: V1 branches
# from V0 at a commit point t_new.  Inventory and the order feed persist
# across the boundary — they are state of the *program*, not of a version —
# and requests can dispatch to either branch depending on its configuration.
#
# The sale is priced statefully, the way real promotions are budgeted: each
# discounted order spends its discount (list − paid) from the budget, and
# once cumulative spend reaches it the sale simply ends — prices revert to
# list.  The budget caps *forgone revenue*, not losses: the cost floor below
# means the sale rarely loses money outright.  `quote` reads
# `is_promo_spent()` — a time-pinned, materializable view over the order feed
# — inside the same transaction that commits the new order, so two concurrent
# orders cannot both spend the last of the budget.  Pre-sale orders carry discount=0, so
# no sale-start timestamp is needed — the ledger anchors itself.
#
# `quote`'s postcondition is inherited unchanged, and it is why the cost
# floor exists: the unclamped half-off sale violates `p >= item.cost * qty`
# on the low-margin "poster" (sale 5 < cost 9), so the naive discount is
# rejected at compile time.  The oversell refinement and the below-cost
# contract hold across the upgrade by construction.

catalog = [
    "tee-black" -> (price=25, cost=11),
    "hoodie"    -> (price=60, cost=34),
    "poster"    -> (price=10, cost=9),   # low margin: the discount clamps here
]

inventory: Mut(Map(String, {Int where _ >= 0}), Txn) := [
    "tee-black" -> 500,
    "hoodie"    -> 200,
    "poster"    -> 1000,
]

# Committed order lines.  Fed only inside committing transactions, so `o.time`
# in /stats is the feeding transaction's commit time (aborted feeds never
# appear in the collection).  Line items record the discount granted (zero at
# list price), so promo accounting can aggregate spend without re-deriving
# list prices from the catalog.
orders: Feed({sku: String, qty: Int, price: Int, discount: Int})

import http

order_reqs,   order_resps   = http.serve("8080", "POST", "/order")
restock_reqs, restock_resps = http.serve("8080", "POST", "/restock")
stats_reqs,   stats_resps   = http.serve("8080", "GET", "/stats")

# Whether the cumulative promo spend as of the calling transaction exceeds the budget.
# Naming the aggregate makes it a view: denotationally it is just this sum, but the
# runtime is free to materialize it and maintain it incrementally as orders commit,
# rather than rescanning order history on every quote.
def is_promo_spent() => Bool requires Transaction:
    promo_budget = 1000
    now = summon(Transaction).current_time()
    past = orders.restrict(\o -> o.time < now)
    promo_budget <= sum([o.discount for o in past])

def quote(item: {price: Int, cost: Int}, qty: Int) => Int requires Transaction:
    assert qty > 0
    assert item.price >= item.cost
    list_price = item.price * qty
    sale = list_price // 2
    floor = item.cost * qty
    p = if is_promo_spent():
            list_price
        else:
            max([sale, floor])
    assert p >= item.cost * qty
    p

# Reserve stock for one order line.  The write only typechecks because the
# `stock >= qty` guard proves the decrement stays non-negative (see
# nonneg_inventory) — deleting the guard makes the program ill-typed, not the
# store go negative.
def reserve(sku: String, qty: Int) => Bool requires Transaction:
    assert qty > 0
    match inventory[sku]:
        case `some(stock):
            if stock >= qty:
                inventory[sku] := stock - qty
                true
            else:
                false
        case `none: false

for req in order_reqs:
    # The qty > 0 preconditions on reserve/quote force validation at the
    # trust boundary: the calls don't typecheck until the guard is here.
    result = if req.body.qty <= 0:
            http.bad_request("qty must be positive")
        else:
            match catalog[req.body.sku]:
                case `none: http.not_found("no such sku")
                case `some(item):
                    with begin():
                        if reserve(req.body.sku, req.body.qty):
                            price = quote(item, req.body.qty)
                            orders << (sku=req.body.sku, qty=req.body.qty, price=price,
                                       discount=item.price * req.body.qty - price)
                            http.ok(str(price))
                        else:
                            # 409, not 400: the request was well-formed but
                            # refused by current resource state.
                            http.conflict("out of stock")
    order_resps[req.id] = result

for req in restock_reqs:
    result = if req.body.qty <= 0:
            http.bad_request("qty must be positive")
        else:
            with begin():
                match inventory[req.body.sku]:
                    case `some(stock):
                        inventory[req.body.sku] := stock + req.body.qty
                        http.ok("restocked")
                    case `none: http.not_found("no such sku")
    restock_resps[req.id] = result

# Revenue per SKU as a view at the request's own transaction time: restrict
# the order feed to transactions that committed before this one began, then
# roll up (see ledger_balance for the idiom in isolation).  Unrestricted, the
# rollup is only defined once the order stream is exhausted — for a server,
# never.
for req in stats_reqs:
    with begin() as txn:
        paid = orders.restrict(\o -> o.time < txn.current_time())
        revenue = [key -> sum([o.price for o in g]) for key -> g in groupby(paid, \o -> o.sku)]
    stats_resps[req.id] = revenue
