# A scalar transactional mutable variable shared *live* across two endpoints: POST /set
# overwrites `latest` (a `Mut(String, Txn)` scalar store) and replies "ok"; GET /get
# reads the current value cross-endpoint inside a `with begin():` block that only reads.
#
# The GET block is a transaction of `latest`'s store like the POST block: it takes its
# place in the commit order when the request arrives and reads `latest` there, and its
# reply rides its commit keyed by the GET request, which is how the HTTP response sink
# dispatches replies to their requests.
#
# The POST reply `http_set_resps_replies << "ok\n"` is a sibling of the `with begin():` block,
# so it rides the POST request loop (request-indexed), matching how the HTTP
# response sink dispatches replies to their requests.
#
# `latest` is declared after the `http_serve` bindings: its writer iterates
# `set_reqs`, so `set_reqs` must be in scope.
#
# Manual smoke test (replace {PORT} with e.g. 8080):
#
#     cargo run -- tests/programs/http_counter/program.cambra
#     curl -X POST -d 'alice' localhost:8080/set
#     curl -X POST -d 'bob'   localhost:8080/set
#     curl localhost:8080/get        # -> bob

run std::http(port="{PORT}", method="POST", path="/set") as http_set_resps
http_set_resps_replies: Feed(String)
set_reqs = http_set_resps::requests
run std::http(port="{PORT}", method="GET", path="/get") as http_get_resps
http_get_resps_replies: Feed(String)
get_reqs = http_get_resps::requests

latest: Mut(String, Txn) := "(none)"

for msg in set_reqs:
    with begin():
        latest := msg
    http_set_resps_replies << "ok\n"

for req in get_reqs:
    with begin():
        http_get_resps_replies << latest
http_set_resps::respond(http_set_resps_replies)
http_get_resps::respond(http_get_resps_replies)
