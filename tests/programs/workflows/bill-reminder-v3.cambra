# v3 of the bill reminder's versions: fix the SMS body, and resend the SMSes v2 failed
# (docs/libs/workflow_library.md, "Example: the bill reminder's versions"). Does not compile;
# `[proposed]` marks what the compiler lacks.
#
# Reloaded over a running v2. The fix is `sms_body`, which every later send applies. The resend is a
# loop over `send_sms::failed`, which reads every failed SMS not yet resolved, including those that
# failed before the reload. Each one Twilio refused for its length goes out again with its stored
# body fixed, and is resolved in the same transaction; the LLM is not asked again. The resend is a
# second call site on `send_sms`, under the label `sms_fixed`, so each failure is resent once,
# across reloads and restarts. A resend that fails again is reported to `ops_alerts` and resolved,
# not resent. A failure the fix does not cover stays on `failed` for a later version. Nothing here
# loads from v2.

run std::env as env
import lib         # lib.cambra beside this file: the providers' request and reply types
import std::retry
import std::http   # sketched in stdlib/http.cambra
import std::time
import std::wf

BillId = String

# [proposed] declared traits, and `impl` of a library trait for a user type.
type Bill = {bill_id: BillId}

impl wf::WorkflowState(Bill):
    def get_run_id(self) => String:
        "bill-" + self.bill_id

# A bill is chased for at most a year, and ends `stale after 30 days in which no effect sent or
# settled a call for it. An operator cancels one bill's run through the workflow's cancel route.
run std::wf::workflow(State=Bill, timeout=`after(time::days(365)),
                      stale_after=`after(time::days(30)),
                      control=`serve(port="8080", path="/bills/cancel"))
    as bills

# One run per bill per day, the first when the bill is tracked. `replace: a day still sending when
# the next comes due is cancelled, so a bill never has two reminders in flight, and after downtime
# it gets one reminder, not one per missed day.
run std::wf::schedule(parent=bills, every=time::days(1), on_due=`replace) as daily

# Tracking a bill starts its run; paying it completes the run, which cancels its days. Each route is
# keyed by the client's idempotency key, so a resent request is one request.
# [proposed] typed request rows on `http::serve`.
track_reqs, track_resps = http::serve("8080", "POST", "/bills")
paid_reqs, paid_resps = http::serve("8080", "POST", "/bills/paid")

for r in wf::keyed(track_reqs, by=(r) => r.headers["Idempotency-Key"]):   # r: {bill_id}
    with begin():
        bills::start(Bill(bill_id=r.bill_id))
        track_resps << (bill_id=r.bill_id)

for r in wf::keyed(paid_reqs, by=(r) => r.headers["Idempotency-Key"]):    # r: {bill_id}
    with begin():
        bills::complete(bills::id(Bill(bill_id=r.bill_id)))
        paid_resps << (bill_id=r.bill_id)

# Customer lookup is out of scope: the addresses are derived from the bill id.
def contact(bill_id: BillId) => {email: String, phone: String}:
    (email=bill_id + "@example.com", phone="+1555" + bill_id)

email_chat = lib::openai_chat(base_url=env::var("OPENAI_BASE_URL"),
                              api_key=env::var("OPENAI_API_KEY"), model="gpt-5-mini")
mailman_client = lib::resend(base_url=env::var("RESEND_BASE_URL"),
                             api_key=env::var("RESEND_API_KEY"),
                             from="Bills <bills@example.com>",
                             key_prefix=env::var("DEPLOYMENT") + "/send_email")

run std::wf::effect(workflow=daily, client=email_chat,
                    config=wf::config(retry::default_retry()))
    as compose_email
run std::wf::effect(workflow=daily, client=mailman_client,
                    config=wf::config(retry::default_retry()))
    as send_email

# A day is done once its email is sent. A failed call leaves the day running until the next day
# replaces it.
# [proposed] `causes` syntax for effects and exceptions.
def email_for_day(day) causes wf::WorkflowCancellationException(_):
    match compose_email::send_request(lib::prompt="bill-reminder-email"):
        case `err(f):
            pass
        case `ok(composed):
            match send_email::send_request(lib::to=contact(day.state.parent.bill_id).email,
                                           lib::subject="Your bill is due",
                                           lib::text=composed.lib::text):
                case `err(f):
                    pass
                case `ok(_):
                    with begin():
                        daily::complete(day.id)

daily::for_each(email_for_day)

# One run per bill every other day. Its effects belong to it, so each SMS slot composes and sends
# once, under a key of its own, apart from the day's email. `latest, not `replace: a slot whose SMS
# failed stays running, holding its failure on `send_sms::failed`, so a later version can retry it.
run std::wf::schedule(parent=bills, every=time::days(2), on_due=`latest) as every_other_day

sms_chat = lib::openai_chat(base_url=env::var("OPENAI_BASE_URL"),
                            api_key=env::var("OPENAI_API_KEY"), model="gpt-5-mini")
sms_client = lib::twilio(base_url=env::var("TWILIO_BASE_URL"),
                         account_sid=env::var("TWILIO_ACCOUNT_SID"),
                         auth_token=env::var("TWILIO_AUTH_TOKEN"), from="+15550100000")

run std::wf::effect(workflow=every_other_day, client=sms_chat,
                    config=wf::config(retry::default_retry()))
    as compose_sms
run std::wf::effect(workflow=every_other_day, client=sms_client,
                    config=wf::config(retry::default_retry()))
    as send_sms

def sms_body(text: String) => String:
    truncate(text, 1600)  # [proposed] string slicing

# A slot is done once its SMS is sent.
def sms_for_slot(slot) causes wf::WorkflowCancellationException(_):
    match compose_sms::send_request(lib::prompt="bill-reminder-sms"):
        case `err(f):
            pass
        case `ok(composed):
            match send_sms::send_request(lib::to=contact(slot.state.parent.bill_id).phone,
                                         lib::body=sms_body(composed.lib::text)):
                case `err(f):
                    pass
                case `ok(_):
                    with begin():
                        every_other_day::complete(slot.id)

every_other_day::for_each(sms_for_slot)

# Twilio refused the body: a 400 with error 21617, the failure v2's `sms_body` caused. Twilio
# answered every attempt, so it did not send the SMS, and resending it as a new call is safe
# (docs/libs/workflow_library.md, "Retry").
def body_too_long(f) => Bool:
    match f.last:
        case wf::`reply(http::`status(r)):
            r.http::status == 400 and lib::twilio_error(r) == 21617
        case _:
            False

# The label of the call site that resends an SMS v2's body broke. A resend's key carries it, so a
# failure of a resend is told apart from a failure of a first send.
sms_fixed = wf::label("sms_fixed")

# Failures that need a person: each is reported once.
pub ops_alerts = defer()   # Feed({bill_id, reason, last})

def needs_resend(k, f) => Bool:
    not f.maybe_performed and body_too_long(f) and not k.has_label(sms_fixed)

# The resend: each failure v2's body caused goes out once more with its body fixed, and is resolved
# in the same transaction. A step that a crash interrupts runs again and sends nothing: its
# resend's key is held by `send_sms`.
# [proposed] record update, `(r with f=v)`; and `send_sms::failed` holding the failures from before
# this loop was added (docs/libs/workflow_library.md, "What a loop added by a reload reads").
for k -> f in send_sms::failed if needs_resend(k, f):
    with begin():
        send_sms::requests@sms_fixed << (f.request with lib::body=sms_body(f.request.lib::body))
        send_sms::resolve(k)

# A resend that succeeds completes its slot's run, as the body does for a first send.
for k -> sent in send_sms::responses if k.has_label(sms_fixed):
    with begin():
        every_other_day::complete(k.run)

# A resend that failed again needs a person, not another resend: it is reported once, and resolved.
for k -> f in send_sms::failed if k.has_label(sms_fixed):
    with begin():
        match every_other_day::get(k.run):
            case `some(s):
                ops_alerts << (bill_id=s.parent.bill_id, reason=f.reason, last=f.last)
            case `none:
                pass
        send_sms::resolve(k)
