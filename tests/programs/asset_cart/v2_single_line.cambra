# The single-line cart with **one divisor per asset**, which is what
# `v1_single_line.cambra` assumes away.
#
# v1 prices every line by dividing through `one_btc`, so every asset is taken to hold
# 10^8 base units. Here each asset names its own: `scales` carries satoshis for BTC and
# gwei for ETH, and the checkout and the view both read the divisor out of it.
#
# This is the reload target for `v1_single_line.cambra`: the demo swaps one for the other
# over a running cart. They share one wiring — `v2_single_line.channels.json` repeats
# `v1_single_line.channels.json` — because a reload changes the program and not the
# channels: the same routes, the same feed, the same ports.
#
# A reload keeps what the running version holds, so the cart lines, the balances, the
# holdings and the latest quotes all carry across and only the arithmetic over them
# differs — visibly for an asset whose scale is not 10^8.
#
# Everything else is `v1_single_line.cambra`'s, the refined `Balance` and the atomicity
# claim included; that file's header carries the shape and what the simplification costs.

# Each asset's base unit, and they differ — which is the whole of v2. `one_dollar` is
# the price scale and is shared, so it stays one constant.
satoshi = 10**8
gwei = 10**9
scales = map([("BTC", satoshi), ("ETH", gwei)])

one_dollar = 10**8

AccountId = Int
Microcents = Int
# `>= 0`, not `> 0`: a zero balance is a balance, and `cash >= due` permits spending
# to exactly zero. What the program may not do is write a negative one.
Balance = {Microcents where  _ >= 0}
Ticker = String

# Both accounts open at the same balance, and it is written as a literal. A map
# literal's codomain is the join over its entries, so two entries carrying different
# equations join to a bare `Microcents` and the declaration can no longer be met. The
# equation also has to reduce to a sign on its own: `500 ^* one_dollar` is rejected,
# because the product it carries names `one_dollar`.
opening_balance = 50000000000  # 500 dollars, at `one_dollar`

accts: Mut(Map(AccountId, Balance), Txn) := box(map([
    (1, opening_balance),
    (2, opening_balance),
]))

holdings: Mut(Map({AccountId, Ticker}, Int), Txn) := box(map([
    ((1, "BTC"), 2 * satoshi),
    ((2, "ETH"), 5 * gwei),
]))

cart: Mut(Map(AccountId, {ticker: Ticker, qty: Int}), Txn) := box(map([
    (1, (ticker="BTC", qty=0)),
    (2, (ticker="ETH", qty=0)),
]))

prices: Mut(Map(Ticker, Microcents), Txn) := box(map([
    ("BTC", 0),
    ("ETH", 0),
]))

cart_changes,  cart_change_acks = wasm_serve("PATCH", "/cart")
checkout_reqs, checkout_acks    = wasm_serve("PUT",   "/checkout")
view_requests, view_replies     = wasm_serve("GET",   "/cart")

for c in cart_changes:
    with begin():
        if c.qty >= 0:
            cart[c.account] := (ticker=c.ticker, qty=c.qty)
        cart_change_acks << (ok=(c.qty >= 0), ticker=c.ticker, qty=c.qty)

for r in checkout_reqs:
    with begin():
        cash = accts[r.account]
        line = cart[r.account]
        due = line.qty * prices[line.ticker] // scales[line.ticker]
        # `^-` records the difference, so the debit is typed
        # `{Microcents | __elem == cash ^- due}` rather than a bare `Microcents`, and the
        # guard is assumable inside its own arm. `Balance` demands `__elem >= 0`, which
        # follows from the two. Weaken the guard and the write is ill-typed
        # (`asset_cart_single_line_rejects_a_weakened_checkout_guard`).
        if cash >= due:
            accts[r.account] := cash ^- due
            held = holdings[(r.account, line.ticker)]
            holdings[(r.account, line.ticker)] := held + line.qty
            cart[r.account] := (ticker=line.ticker, qty=0)
        remaining = accts[r.account]
        checkout_acks << (ok=(cash >= due), due=due, cash=remaining)

for v in view_requests:
    with begin():
        line = cart[v.account]
        px = prices[line.ticker]
        view_replies << (
            cash = accts[v.account],
            ticker = line.ticker,
            qty = line.qty,
            price = px,
            total = line.qty * px // scales[line.ticker],
            held = holdings[(v.account, line.ticker)],
        )

for u in price_updates():
    with begin():
        prices[u.ticker] := u.price
