# A live asset cart. Four host channels, declared beside this file; prices are
# integers scaled by 10^8. See `mod.rs` for the rules this shape obeys.
#
# This is the version that runs, and the one the deck presents. The six slots
# and the sink per ticker are not the design — they are what the compiler admits
# today. `v1.cambra` is the same app written as one reader over keyed
# collections, and its header lists the three things standing between the two.
#
# The TODO that used to sit here said this waited on `Mut(Map(K, V), Txn)`. That
# type now exists; writing a key and reading one key both work. What does not is
# reading a whole collection out of a `Mut`, which is the one that keeps the six
# slots here.

btc_updates = [u for u in price_updates() if u.ticker == "BTC-USD"]
eth_updates = [u for u in price_updates() if u.ticker == "ETH-USD"]
sol_updates = [u for u in price_updates() if u.ticker == "SOL-USD"]

btc_changes = [c for c in cart_changes() if c.ticker == "BTC-USD"]
eth_changes = [c for c in cart_changes() if c.ticker == "ETH-USD"]
sol_changes = [c for c in cart_changes() if c.ticker == "SOL-USD"]

btc_px: Mut(Int, Txn) := 0
eth_px: Mut(Int, Txn) := 0
sol_px: Mut(Int, Txn) := 0

btc_qty: Mut(Int, Txn) := 0
eth_qty: Mut(Int, Txn) := 0
sol_qty: Mut(Int, Txn) := 0

for u in btc_updates:
    with begin():
        btc_px := u.price
for u in eth_updates:
    with begin():
        eth_px := u.price
for u in sol_updates:
    with begin():
        sol_px := u.price

for c in btc_changes:
    with begin():
        btc_qty := c.qty
for c in eth_changes:
    with begin():
        eth_qty := c.qty
for c in sol_changes:
    with begin():
        sol_qty := c.qty

for req in view_requests():
    with begin():
        btc_line << (qty=btc_qty, price=btc_px, total=btc_qty * btc_px)
for req in view_requests():
    with begin():
        eth_line << (qty=eth_qty, price=eth_px, total=eth_qty * eth_px)
for req in view_requests():
    with begin():
        sol_line << (qty=sol_qty, price=sol_px, total=sol_qty * sol_px)
