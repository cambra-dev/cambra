# Transactional KV store over HTTP, with a stats endpoint.  /get and /set are
# handled concurrently, so the shared state MUST be transactional: `store` is
# mutable over the transaction time domain (the second type argument — the
# default global `Txn`).  Every access runs inside `with begin():`, so the
# store is never observed in a torn state and the read-modify-write in /set is
# atomic.
#
# /stats contrasts the two idioms: the store uses transactional *mutation*,
# while the write count is a *declarative aggregate* over the request stream
# itself — no mutable counter, no shared state to race on.
#
# `requires Transaction` makes the transaction a contextual requirement, which
# the block calling `put` supplies.  A transaction commits on normal block exit;
# one that should not write is written with a guard that writes nothing.

import std::http

get_reqs,   get_resps   = http.serve("8080", "GET",  "/get")
set_reqs,   set_resps   = http.serve("8080", "POST", "/set")
stats_reqs, stats_resps = http.serve("8080", "GET",  "/stats")

store: Mut(Map(String, String), Txn) := []

def put(key: String, value: String) requires Transaction:
    store[key] := value

for req in set_reqs:
    with begin():
        # Insert only if absent.  The read and write share one transaction, so
        # two concurrent /set requests for the same key can't both observe it
        # missing and both insert — the read-modify-write is atomic.
        match store[req.body.key]:
            case `some(_):
                pass
            case `none:    put(req.body.key, req.body.value)
    set_resps[req.id] = "ok\n"

for req in get_reqs:
    with begin():
        result = store[req.query.key]
    get_resps[req.id] = match result:
        case `some(v): v
        case `none:    http.not_found("no such key\n")

# Write count as a declarative aggregate over the /set request stream — a view,
# not mutable state.  `set_reqs` fans out to both the writer loop above and
# this counter.
for req in stats_reqs:
    with txn = begin():
        num_writes = count(set_reqs.restrict(\r -> r.time < txn::now()))
        stats_resps[req.id] = str(num_writes) + "\n"
