{
  "remoteControlAtStartup": true,
  "attribution": {
    "commit": "",
    "sessionUrl": false,
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(awk *)",
      "Bash(cargo build)",
      "Bash(cargo build *)",
      "Bash(cargo test)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt)",
      "Bash(cargo fmt *)",
      "Bash(cat *)",
      "Bash(./ci.sh)",
      "Bash(./ci.sh *)",
      "Bash(head *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git stash)",
      "Bash(git stash *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh run *)",
      "Bash(gh api *)",
      "Bash(gh cache *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(tail *)",
      "WebSearch",

      "Bash(git check-ignore *)",
      "Bash(git ls-tree *)",

      "Bash(jj --version)",
      "Bash(jj log *)",
      "Bash(jj st *)",
      "Bash(jj status *)",
      "Bash(jj diff *)",
      "Bash(jj show *)",
      "Bash(jj file *)",
      "Bash(jj root *)",
      "Bash(jj next *)",
      "Bash(jj config *)",
      "Bash(jj bookmark *)",
      "Bash(jj describe *)",
      "Bash(jj workspace *)",
      "Bash(jj op *)",
      "Bash(jj git *)",
      "Bash(jj new)",
      "Bash(jj new *)",
      "Bash(jj rebase *)",
      "Bash(jj edit *)",
      "Bash(jj abandon *)",
      "Bash(jj resolve *)",

      "Bash(cargo --version)",
      "Bash(cargo doc *)",
      "Bash(cargo tree *)",
      "Bash(RUSTDOCFLAGS=\"-A warnings -D rustdoc::broken_intra_doc_links\" cargo doc --no-deps -p cambra*)",
      "Bash(timeout 3000 cargo nextest run --all-features)",
      "Bash(rustc --version)",
      "Bash(rust-analyzer --version)",
      "Bash(rustup show *)",
      "Bash(rustup component *)",

      "Bash(npm --version)",
      "Bash(npm install *)",
      "Bash(timeout 180 npm run typecheck)",
      "Bash(timeout 180 npm run test)",
      "Bash(timeout 240 npm run build)",

      "Bash(./target/debug/cambra-inspector *)",
      "Bash(curl -s http://localhost*/api/snapshot)",
      "Bash(pkill -f cambra-inspector*)",

      "Bash(.claude/skills/gh-pr-respond/gh_pr_comments.sh *)"
    ],
    "deny": [
      "Bash(npm run dev)",
      "Bash(jj squash)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/prose-check.py\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Checking prose"
          }
        ]
      }
    ]
  }
}
