# A program that imports `std::time` and records a deadline and elapsed duration per input line.

import std::time

started = time::now()
deadlines: Mut(Map(String, time::Instant), Txn) := Map::empty
elapsed: Mut(Map(String, time::Duration), Txn) := Map::empty

for line in stdin():
    with begin():
        deadlines[line] := time::now() + time::minutes(30)
        elapsed[line] := time::now() - started
