# HTTP request and response values and pure response helpers.
# Import this module for its types. Run std::http::serve for each route.
# Bodies are UTF-8 Strings; header lists retain their order and repeated names.
# Sending validates field syntax and reserves framing headers for the transport.
# Example:
#     import std::http
#     reply = http::ok_text("hello")
# Status: implemented.

pub type Header:
    new(name: String, value: String)

impl Header:
    pub def name(self) => String:
        match self:
            case Header::new(name, value): name
    pub def value(self) => String:
        match self:
            case Header::new(name, value): value

pub type Request:
    new(method: String, target: String, headers: List(Header), body: String)

impl Request:
    pub def method(self) => String:
        match self:
            case Request::new(method, target, headers, body): method
    pub def target(self) => String:
        match self:
            case Request::new(method, target, headers, body): target
    pub def headers(self) => List(Header):
        match self:
            case Request::new(method, target, headers, body): headers
    pub def body(self) => String:
        match self:
            case Request::new(method, target, headers, body): body

# A final response status. Informational responses and protocol upgrades need a separate API.
pub Status = {Int where _ >= 200 and _ <= 599}

pub type Response:
    new(status: Status, headers: List(Header), body: String)

impl Response:
    pub def status(self) => Status:
        match self:
            case Response::new(status, headers, body): status
    pub def headers(self) => List(Header):
        match self:
            case Response::new(status, headers, body): headers
    pub def body(self) => String:
        match self:
            case Response::new(status, headers, body): body

# A successful UTF-8 plain-text response.
pub def ok_text(body: String) => Response:
    Response::new(200, box([Header::new("Content-Type", "text/plain; charset=utf-8")]), body)

# A successful UTF-8 HTML response.
pub def ok_html(body: String) => Response:
    Response::new(200, box([Header::new("Content-Type", "text/html; charset=utf-8")]), body)
