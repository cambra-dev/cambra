# One HTTP route, with its request domain and a complete response definition.
# Run once per (port, method, path). Routes on one port share their listener.
# Invalid UTF-8 bodies receive 400 before admission. Routing matches the method exactly and
# the path before the query string in RFC 3986 normal form (/a%62 is /ab, /ping/ is not /ping);
# Request.target retains the whole target. Each admitted request receives its response when
# defined.
# Example:
#     import std::http
#     run std::http::serve(port="8080", method="POST", path="/echo") as server
#     server::respond([http::ok_text(req.body()) for req in server::requests])
# Status: implemented.

import std::http

const param port: String
const param method: String
const param path: String

# The compiler supplies the route at this run's address: the key type of its requests, the
# requests it admits, and the Feed its responses go to.
@Builtin
pub type Reqs

@Builtin
_requests: Reqs |=> {String, String, List({String, String}), String}

@Builtin
_responses: Feed(http::Response)

pub requests = [
    http::Request::new(r.0, r.1, box([http::Header::new(h.0, h.1) for h in r.2]), r.3)
    for r in _requests
]

# Connects one response per admitted request. The connection is defined once per run.
pub def respond(values: Reqs |=> http::Response):
    _responses <<= values
